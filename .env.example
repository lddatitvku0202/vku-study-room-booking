# Environment template — copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored; this template is tracked. NEVER commit real values here.
# These variables are read by app.config.ts and injected into the app manifest
# (`extra`), then validated at startup by src/services/config.ts.
#
# Note on exposure: the Firebase *web* config below is public by design — it
# ships inside every client build and is not a secret (CLAUDE.md §8). Privileged
# credentials (service-account JSON, private keys) are NEVER placed in this file
# or anywhere else in the repository.

# ---------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------
# One of: development | production
APP_ENV=development

# Point Auth/Firestore at the local Firebase Emulator Suite instead of the
# cloud project. One of: true | false
USE_FIREBASE_EMULATOR=false

# Host used to reach the emulator. Use 127.0.0.1 for a simulator, or your
# machine's LAN IP (e.g. 192.168.1.10) when testing on a physical device.
EMULATOR_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Firebase web configuration
# ---------------------------------------------------------------------------
# Values come from Firebase console → Project settings → Your apps → Web app.
# The Firebase project is created in TASK 06; until then these hold obviously
# fake PLACEHOLDER values so the app boots. The Emergency MVP does not use
# Firebase at all, so a straight `cp .env.example .env` is enough to run it.
# Replace them with the real web config only when the Firebase track resumes.
FIREBASE_API_KEY=demo-placeholder-api-key
FIREBASE_AUTH_DOMAIN=demo-placeholder.firebaseapp.com
FIREBASE_PROJECT_ID=demo-placeholder
FIREBASE_STORAGE_BUCKET=demo-placeholder.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:demo-placeholder
