{
  "name": "vku-study-room-booking",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.2",
    "date-fns": "^4.4.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.19",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-vku-study-room-booking \"vitest run --config vitest.emulator.config.mjs\"",
    "seed:rooms": "tsx scripts/seed-rooms.ts",
    "demo:contention": "tsx scripts/contention-demo.ts",
    "demo:contention:emulator": "firebase emulators:exec --only auth,firestore --project demo-vku-study-room-booking \"npm run seed:rooms -- --emulator && tsx scripts/contention-demo.ts --emulator\""
  },
  "private": true
}
